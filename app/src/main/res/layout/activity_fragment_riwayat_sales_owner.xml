<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6">

    <LinearLayout
        android:id="@+id/containerRiwayat"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riwayat Kunjungan Sales"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <Button
                android:id="@+id/btnTambahJadwal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Jadwal"
                android:textSize="12sp"
                android:backgroundTint="#2E7D32"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="4dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp">
                    <TableRow android:background="#F5F5F5">
                        <TextView android:text="No" android:padding="8dp" android:textStyle="bold"/>
                        <TextView android:text="Nama Sales" android:padding="8dp" android:textStyle="bold"/>
                        <TextView android:text="Status" android:padding="8dp" android:textStyle="bold"/>
                        <TextView android:text="Aksi" android:padding="8dp" android:textStyle="bold"/>
                    </TableRow>
                    <TableRow>
                        <TextView android:text="1" android:padding="8dp"/>
                        <TextView android:text="Grosir Mie Instan" android:padding="8dp"/>
                        <TextView android:text="SUDAH DATANG" android:textColor="#2E7D32" android:padding="8dp"/>
                        <Button android:layout_width="wrap_content" android:layout_height="30dp" android:text="Detail" android:textSize="10sp"/>
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>