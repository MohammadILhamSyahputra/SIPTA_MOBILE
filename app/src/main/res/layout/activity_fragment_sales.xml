<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manajemen Data Sales"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/edNamaSales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nama Sales"
                    android:layout_marginBottom="8dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="10dp" />

                <EditText
                    android:id="@+id/edNoTelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="No. Telepon"
                    android:inputType="phone"
                    android:layout_marginBottom="8dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="10dp" />

                <EditText
                    android:id="@+id/edAlamatSales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Alamat Sales"
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvKoordinatSales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Titik Koordinat: (Klik pada peta untuk mengunci lokasi sales)"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#3D5F52" />

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapSales"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="6dp"
                        android:background="#E0E0E0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btnInsertSales"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="TAMBAH"
                        android:backgroundTint="#3D5F52" android:textColor="#FFF" />

                    <Button android:id="@+id/btnUpdateSales"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="EDIT"
                        android:layout_marginStart="4dp" android:backgroundTint="#FBC02D"
                        android:textColor="#000" />

                    <Button android:id="@+id/btnDeleteSales"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="HAPUS"
                        android:layout_marginStart="4dp" android:backgroundTint="#D32F2F"
                        android:textColor="#FFF" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Sales Terdaftar:"
            android:textColor="#333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:layout_marginTop="8dp"/>

        <ListView
            android:id="@+id/lsSales"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:nestedScrollingEnabled="true"
            android:background="#FFFFFF"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="0.5dp"/>

    </LinearLayout>
</ScrollView>