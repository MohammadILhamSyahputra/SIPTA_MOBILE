<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6">

    <LinearLayout
        android:id="@+id/containerPenjualan"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laporan Penjualan"
            android:textSize="20sp"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText android:id="@+id/etTglMulaiJual" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tanggal Mulai" android:focusable="false"/>
                <EditText android:id="@+id/etTglAkhirJual" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tanggal Akhir" android:focusable="false"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnTampilkanLap" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Tampilkan" android:backgroundTint="#2E7D32" android:layout_marginEnd="4dp"/>
                    <Button android:id="@+id/btnExportPdf" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Export PDF" android:backgroundTint="#D32F2F"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvTotalPenjualan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Keseluruhan: Rp 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:textColor="#2E7D32"/>

        <LinearLayout
            android:id="@+id/layoutHasilPenjualan"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>